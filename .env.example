# Required for OI history snapshots. Use your Vercel Postgres / Neon pooled connection string.
POSTGRES_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required in production to protect /api/cron/snapshot-oi.
# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET> for Cron Jobs.
CRON_SECRET=replace_with_a_random_string_at_least_16_chars

# Optional. CoinGecko free Basic/Demo key for coin profiles and market metadata.
# Paid Pro keys should use COINGECKO_PRO_API_KEY instead.
COINGECKO_API_KEY=
